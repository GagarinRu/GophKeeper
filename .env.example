# PostgreSQL (docker compose)
POSTGRES_USER=gophkeeper
POSTGRES_PASSWORD=gophkeeper
POSTGRES_DB=gophkeeper
POSTGRES_PORT=5432

# Опционально для сервера (или передать flags: -d, -jwt-secret, -data-key)
# DATABASE_DSN=postgres://gophkeeper:gophkeeper@localhost:5432/gophkeeper?sslmode=disable
# JWT_SECRET=change-me-in-production
# DATA_ENCRYPTION_KEY=change-me-data-key
